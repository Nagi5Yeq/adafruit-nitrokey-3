+fn p384_cose_public_key(raw: &[u8]) -> SerializedKey {
+    let (x, y) = raw.split_at(raw.len() / 2);
+    let key = cosey::P384PublicKey {
+        x: x.try_into().unwrap(),
+        y: y.try_into().unwrap(),
+    };
+    let mut buffer = [0u8; 128];
+    let serialized = ctap_types::serde::cbor_serialize(&key, &mut buffer).unwrap();
+    SerializedKey::try_from(&*serialized).unwrap()
+}
